# SPDX-License-Identifier: MIT
# Script mode helper: converts each file in IN_DIR into a C++ byte array.
#
#   cmake -DIN_DIR=<web dir> -DOUT_FILE=<header path> -P cmake/embed_web.cmake
#
# The generated header defines netra::web::kAssets / kAssetCount and is included
# by src/dashboard/assets.cpp when NETRA_EMBED_WEB is on.

if(NOT DEFINED IN_DIR OR NOT DEFINED OUT_FILE)
    message(FATAL_ERROR "IN_DIR and OUT_FILE must be provided")
endif()

file(GLOB _files RELATIVE ${IN_DIR} ${IN_DIR}/*)
list(SORT _files)

set(_out "// SPDX-License-Identifier: MIT\n")
string(APPEND _out "// Generated by cmake/embed_web.cmake - do not edit.\n")
string(APPEND _out "#pragma once\n\n")
string(APPEND _out "#include <cstddef>\n#include <string_view>\n\n")
string(APPEND _out "namespace netra::web {\n\n")
string(APPEND _out "struct Asset {\n")
string(APPEND _out "    const char* path;\n")
string(APPEND _out "    const char* mimeType;\n")
string(APPEND _out "    const unsigned char* data;\n")
string(APPEND _out "    size_t size;\n")
string(APPEND _out "    std::string_view view() const { return std::string_view(reinterpret_cast<const char*>(data), size); }\n")
string(APPEND _out "};\n\n")

# Entries are accumulated as plain text (CMake lists would split MIME types on ';').
set(_entries "")
set(_count_assets 0)

foreach(_file IN LISTS _files)
    if(IS_DIRECTORY ${IN_DIR}/${_file})
        continue()
    endif()
    file(READ ${IN_DIR}/${_file} _hex HEX)
    string(LENGTH "${_hex}" _hexlen)
    if(_hexlen EQUAL 0)
        continue()
    endif()
    math(EXPR _size "${_hexlen} / 2")

    string(MAKE_C_IDENTIFIER "${_file}" _symbol)
    string(APPEND _out "static const unsigned char k_${_symbol}[] = {")

    set(_line "")
    set(_bytes_on_line 0)
    math(EXPR _last "${_hexlen} - 2")
    foreach(_index RANGE 0 ${_last} 2)
        string(SUBSTRING "${_hex}" ${_index} 2 _byte)
        string(APPEND _line "0x${_byte},")
        math(EXPR _bytes_on_line "${_bytes_on_line} + 1")
        if(_bytes_on_line EQUAL 24)
            string(APPEND _out "\n    ${_line}")
            set(_line "")
            set(_bytes_on_line 0)
        endif()
    endforeach()
    if(NOT "${_line}" STREQUAL "")
        string(APPEND _out "\n    ${_line}")
    endif()
    string(APPEND _out "0x00};\n")
    string(APPEND _out "static const size_t k_${_symbol}_size = ${_size};\n\n")

    # Content type by extension.
    set(_mime "application/octet-stream")
    if(_file MATCHES "\\.html$")
        set(_mime "text/html; charset=utf-8")
    elseif(_file MATCHES "\\.css$")
        set(_mime "text/css; charset=utf-8")
    elseif(_file MATCHES "\\.js$")
        set(_mime "application/javascript; charset=utf-8")
    elseif(_file MATCHES "\\.mjs$")
        set(_mime "application/javascript; charset=utf-8")
    elseif(_file MATCHES "\\.json$")
        set(_mime "application/json")
    elseif(_file MATCHES "\\.svg$")
        set(_mime "image/svg+xml")
    elseif(_file MATCHES "\\.png$")
        set(_mime "image/png")
    elseif(_file MATCHES "\\.jpe?g$")
        set(_mime "image/jpeg")
    elseif(_file MATCHES "\\.gif$")
        set(_mime "image/gif")
    elseif(_file MATCHES "\\.webp$")
        set(_mime "image/webp")
    elseif(_file MATCHES "\\.ico$")
        set(_mime "image/x-icon")
    elseif(_file MATCHES "\\.woff2?$")
        set(_mime "font/woff2")
    elseif(_file MATCHES "\\.txt$")
        set(_mime "text/plain; charset=utf-8")
    elseif(_file MATCHES "\\.map$")
        set(_mime "application/json")
    endif()

    if(NOT _entries STREQUAL "")
        string(APPEND _entries ",\n")
    endif()
    string(APPEND _entries "    {\"${_file}\", \"${_mime}\", k_${_symbol}, k_${_symbol}_size}")
    math(EXPR _count_assets "${_count_assets} + 1")
endforeach()

string(APPEND _out "static const Asset kAssets[] = {\n")
if(_entries STREQUAL "")
    string(APPEND _out "    {nullptr, nullptr, nullptr, 0}")
else()
    string(APPEND _out "${_entries}")
endif()
string(APPEND _out "\n};\n\n")
string(APPEND _out "static const size_t kAssetCount = ${_count_assets};\n\n")
string(APPEND _out "}  // namespace netra::web\n")

get_filename_component(_dir ${OUT_FILE} DIRECTORY)
file(MAKE_DIRECTORY ${_dir})
file(WRITE ${OUT_FILE} "${_out}")
message(STATUS "Embedded ${_count_assets} web asset(s) into ${OUT_FILE}")
